# ==============================================================================
# Scaleway TEM Multitenant Mail Sender Configuration
# ==============================================================================

# Server
PORT=8080

# Master Admin Key (Required for /admin/** routes: creating tenants, rotating keys)
MASTER_API_KEY=master_super_secret_key_change_in_production

# Scaleway Transactional Email (TEM) Credentials
# Retrieve from Scaleway Console -> Credentials (API Key) & Project Settings
SCW_SECRET_KEY=your-scaleway-secret-key-here
SCW_PROJECT_ID=00000000-0000-0000-0000-000000000000
SCW_REGION=fr-par

# Set to true for offline testing or local development without Scaleway credentials
MOCK_SCALEWAY=false

# Database Configuration
# Default is persistent H2 in PostgreSQL compatibility mode stored in ./data/
DATABASE_URL=jdbc:h2:file:./data/mail_sender;DB_CLOSE_ON_EXIT=FALSE;AUTO_RECONNECT=TRUE;MODE=PostgreSQL
DATABASE_USER=sa
DATABASE_PASSWORD=

# Reliable Queue & Outbox Worker Settings
WORKER_ENABLED=true
QUEUE_POLL_INTERVAL=2s
QUEUE_BATCH_SIZE=10
MAX_RETRY_ATTEMPTS=5
INITIAL_RETRY_DELAY=3s
MAX_RETRY_DELAY=300s

# Default Daily Sending Quota per Tenant
DEFAULT_DAILY_QUOTA=10000
